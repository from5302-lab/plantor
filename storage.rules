rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true
        || request.auth.token.email == 'from5302@gmail.com'
        || request.auth.token.email == 'from302@plantor.app'
      );
    }

    match /screenshots/{childId}/{fileName} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
    match /vault-receipts/{entryId}/{fileName} {
      allow read, write: if isAdmin();
    }
    match /serviceIcons/{slug}/{fileName} {
      allow write: if request.auth != null;
      allow read: if true;
    }
  }
}
