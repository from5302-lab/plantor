rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true
        || request.auth.token.email == 'from5302@gmail.com'
        || request.auth.token.email == 'from302@plantor.app'
      );
    }

    match /screenshots/{childId}/{fileName} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
    match /vault-receipts/{entryId}/{fileName} {
      allow read, write: if isAdmin();
    }
    match /serviceIcons/{slug}/{fileName} {
      allow write: if request.auth != null;
      allow read: if true;
    }

    // 캠퍼스 캐릭터 스냅샷(전신·얼굴). 피드는 비로그인도 보므로 공개 읽기다.
    // 쓰기는 publishCampusLook 콜러블(admin SDK)만 — 클라이언트가 직접 올리면
    // 남의 childId 경로에 아무 그림이나 넣을 수 있다.
    match /campus-shots/{childId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
