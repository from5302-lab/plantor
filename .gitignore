# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase functions build output
functions/lib/
functions/.next/
functions/node_modules/
.firebase/

# Kenney 에셋 라이브러리(수백 MB). 실제로 쓰는 모델만 public/campus/models/ 로 복사한다.
# 원본은 kenney.nl 에서 언제든 다시 받을 수 있다(CC0).
assets/kenney/
